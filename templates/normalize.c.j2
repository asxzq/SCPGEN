/**
 * {{ problem_name }} — Normalization / Denormalization.
 *
 * Auto-generated by scpgen v{{ version }}.
 *
 * Physical ↔ Normalized conversion using dimensional scales.
 */

#include "{{ problem_name }}.h"

/* ── Scale Factors ───────────────────────────────────────────────────────── */

{% for dim_name, scale_val in scale_values.items() %}
#define SCALE_{{ dim_name | upper }}  {{ scale_val }}
{% endfor %}

/* Variable → dimension mapping (for user reference) */
{% for v in all_variables %}
/*   {{ v.name }}: {{ v.dimension }} (scale = {{ scale_values.get(v.dimension, 1.0) }}) */
{% endfor %}

/* ── Normalize (physical → normalized) ───────────────────────────────────── */

void {{ problem_name }}_normalize_state(const double phys[{{ guard_name }}_N_STATES], double norm[{{ guard_name }}_N_STATES])
{
{% for s in states %}
{% set s_dim = s.dimension if s.dimension else 'dimensionless' %}
    norm[{{ loop.index0 }}] = phys[{{ loop.index0 }}] / SCALE_{{ s_dim | upper }};
{% endfor %}
}

void {{ problem_name }}_normalize_control(const double phys[{{ guard_name }}_N_CONTROLS], double norm[{{ guard_name }}_N_CONTROLS])
{
{% for c in controls %}
{% set c_dim = c.dimension if c.dimension else 'dimensionless' %}
    norm[{{ loop.index0 }}] = phys[{{ loop.index0 }}] / SCALE_{{ c_dim | upper }};
{% endfor %}
}

/* ── Denormalize (normalized → physical) ─────────────────────────────────── */

void {{ problem_name }}_denormalize_state(const double norm[{{ guard_name }}_N_STATES], double phys[{{ guard_name }}_N_STATES])
{
{% for s in states %}
{% set s_dim = s.dimension if s.dimension else 'dimensionless' %}
    phys[{{ loop.index0 }}] = norm[{{ loop.index0 }}] * SCALE_{{ s_dim | upper }};
{% endfor %}
}

void {{ problem_name }}_denormalize_control(const double norm[{{ guard_name }}_N_CONTROLS], double phys[{{ guard_name }}_N_CONTROLS])
{
{% for c in controls %}
{% set c_dim = c.dimension if c.dimension else 'dimensionless' %}
    phys[{{ loop.index0 }}] = norm[{{ loop.index0 }}] * SCALE_{{ c_dim | upper }};
{% endfor %}
}

/* ── Parameter Normalization (PHYSICAL → NORMALIZED) ────────────────────── */

void {{ problem_name }}_params_normalize(const {{ problem_name | capitalize }}Params *phys,
                                          {{ problem_name | capitalize }}ParamsNorm *norm)
{
    *norm = *phys;
    /* TODO: Normalize dimensioned parameters by their dimension scales.
     *       Add parameter-to-dimension mapping to YAML for auto-generation.
     */
}
