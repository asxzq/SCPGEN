/* ── Local dimension aliases (from prefixed config macros) ──────────────── */

#define N_INTERVALS     {{ guard_name }}_N_INTERVALS
#define N_NODES         {{ guard_name }}_N_NODES
#define FINAL_NODE      {{ guard_name }}_FINAL_NODE
#define N_STATES        {{ guard_name }}_N_STATES
#define N_CONTROLS      {{ guard_name }}_N_CONTROLS
#define N_AUX           {{ guard_name }}_N_AUX
#define VARS_PER_NODE   {{ guard_name }}_VARS_PER_NODE
#define NVAR            {{ guard_name }}_NVAR
#define NEQ             {{ guard_name }}_NEQ
#define NINEQ           {{ guard_name }}_NINEQ
#define MAX_ITER        {{ guard_name }}_MAX_ITER
#define EPS_CONVERGENCE {{ guard_name }}_EPS_CONVERGENCE

/* ══════════════════════════════════════════════════════════════════════════
 * USER: Provide initial/target values in PHYSICAL units here.
 *       Normalization will be applied automatically.
 * ══════════════════════════════════════════════════════════════════════════ */

/* ── Initial state (PHYSICAL units) ── */
{% for s in states %}
#define {{ guard_name }}_INIT_{{ s.name | upper }}  0.0  /* TODO: physical {{ s.name }} */
{% endfor %}
{% for c in controls %}
#define {{ guard_name }}_INIT_{{ c.name | upper }}  0.0  /* TODO: physical {{ c.name }} */
{% endfor %}

/* ── Terminal constraints (PHYSICAL units) ── */
{% for s in states %}
{% if s.name in ['lambda','phi','theta','sigma','r','V'] %}
#define {{ guard_name }}_FINAL_{{ s.name | upper }} 0.0  /* TODO: physical {{ s.name }} at final node */
{% endif %}
{% endfor %}

/* ── User physical initial state/control arrays ── */
static double user_x0[N_STATES] = {
{% for s in states %}
    {{ guard_name }}_INIT_{{ s.name | upper }}{% if not loop.last %},{% endif %}
{% endfor %}
};
static double user_u0[N_CONTROLS] = {
{% for c in controls %}
    {{ guard_name }}_INIT_{{ c.name | upper }}{% if not loop.last %},{% endif %}
{% endfor %}
};
static double user_T_total = 1.0;  /* Physical total time */

/* ── Initialization ──────────────────────────────────────────────────────── */

void {{ problem_name }}_init_reference({{ problem_name | capitalize }}Workspace *w,
                                        const {{ problem_name | capitalize }}Params *p,
                                        const double x0_phys[N_STATES],
                                        const double u0_phys[N_CONTROLS],
                                        double T_total)
{
    int k, i;
    double dt_norm;

    /* Normalize initial state */
    double x0_norm[N_STATES], u0_norm[N_CONTROLS];
    {{ problem_name }}_normalize_state(x0_phys, x0_norm);
    {{ problem_name }}_normalize_control(u0_phys, u0_norm);

    /* Normalize total time */
    double T_norm = T_total / {{ scale_values.get('time', 1.0) }};
    w->T_total = T_norm;

    /* Time step per interval (uniform for now) */
    dt_norm = T_norm / N_INTERVALS;
    for (k = 0; k < N_INTERVALS; k++)
        w->dt_seq[k] = dt_norm;

    /* Constant control sequence (normalized) */
    for (k = 0; k < N_NODES; k++)
        for (i = 0; i < N_CONTROLS; i++)
            w->U_ref[k * N_CONTROLS + i] = u0_norm[i];

    /* Forward integrate (physical space) to get initial state trajectory */
    /* Convert normalized init state back to physical for integration */
    double x0_phys_copy[N_STATES];  /* already physical */
    memcpy(x0_phys_copy, x0_phys, N_STATES * sizeof(double));
    double u_seq_phys[N_CONTROLS * N_NODES];
    for (k = 0; k < N_NODES; k++)
        for (i = 0; i < N_CONTROLS; i++)
            u_seq_phys[k * N_CONTROLS + i] = u0_phys[i];

    double X_phys[N_STATES * N_NODES];
    double dt_phys_seq[N_INTERVALS];
    for (k = 0; k < N_INTERVALS; k++)
        dt_phys_seq[k] = dt_norm * {{ scale_values.get('time', 1.0) }};

    {{ problem_name }}_integrate_trajectory(x0_phys_copy, u_seq_phys, dt_phys_seq, X_phys, p);

    /* Normalize state trajectory */
    for (k = 0; k < N_NODES; k++) {
        double s_phys[N_STATES], s_norm[N_STATES];
        for (i = 0; i < N_STATES; i++)
            s_phys[i] = X_phys[k * N_STATES + i];
        {{ problem_name }}_normalize_state(s_phys, s_norm);
        for (i = 0; i < N_STATES; i++)
            w->X_ref[k * N_STATES + i] = s_norm[i];
    }
}

void {{ problem_name }}_build_x_ref({{ problem_name | capitalize }}Workspace *w) {
    int k, i;
    for (k = 0; k < N_NODES; k++) {
        for (i = 0; i < N_STATES; i++)
            w->x_ref[k * VARS_PER_NODE + i] = w->X_ref[k * N_STATES + i];
        for (i = 0; i < N_CONTROLS; i++)
            w->x_ref[k * VARS_PER_NODE + N_STATES + i] = w->U_ref[k * N_CONTROLS + i];
        for (i = 0; i < N_AUX; i++)
            w->x_ref[k * VARS_PER_NODE + N_STATES + N_CONTROLS + i] = 0.0;
    }
    /* Zero-initialize extra variables (slack, virtual control, delta_T, etc.) */
    for (i = N_NODES * VARS_PER_NODE; i < NUMBER_N; i++)
        w->x_ref[i] = 0.0;
}

/* ── SCP Iteration ───────────────────────────────────────────────────────── */

int {{ problem_name }}_scp_iteration({{ problem_name | capitalize }}Workspace *w,
                                      const {{ problem_name | capitalize }}ParamsNorm *p)
{
    int exitflag;
    double norm_dx = 0.0;
    int j;

{% if scp_params.is_perturbation %}
    /* PERTURBATION mode: variable = dx, update x_ref += dx */
    {{ problem_name }}_fill_matrix(w->x_ref, w->dt_seq, p);
    exitflag = {{ problem_name }}_solve_socp();
    if (exitflag != 0) {
        printf("SCP: ECOS solve failed (flag=%d)\n", exitflag);
        return exitflag;
    }
    double dx[NUMBER_N];
    {{ problem_name }}_get_solution(dx);
    for (j = 0; j < NUMBER_N; j++) {
        w->x_ref[j] += dx[j];
        norm_dx += dx[j] * dx[j];
    }
    norm_dx = sqrt(norm_dx);
    printf("SCP iter %d: ||dx|| = %e\n", w->iteration, norm_dx);
{% else %}
    /* DIRECT mode: variable = x, reference = solution */
    {{ problem_name }}_fill_matrix(w->x_ref, w->dt_seq, p);
    exitflag = {{ problem_name }}_solve_socp();
    if (exitflag != 0) {
        printf("SCP: ECOS solve failed (flag=%d)\n", exitflag);
        return exitflag;
    }
    double x_new[NUMBER_N];
    {{ problem_name }}_get_solution(x_new);
    for (j = 0; j < NUMBER_N; j++) {
        double dj = x_new[j] - w->x_ref[j];
        w->x_ref[j] = x_new[j];
        norm_dx += dj * dj;
    }
    norm_dx = sqrt(norm_dx);
    printf("SCP iter %d: ||x_new-x_ref|| = %e\n", w->iteration, norm_dx);
{% endif %}

    w->norm_dx = norm_dx;
    w->iteration++;

    /* Extract trajectories from x_ref */
    int k, i;
    for (k = 0; k < N_NODES; k++) {
        for (i = 0; i < N_STATES; i++)
            w->X_ref[k * N_STATES + i] = w->x_ref[k * VARS_PER_NODE + i];
        for (i = 0; i < N_CONTROLS; i++)
            w->U_ref[k * N_CONTROLS + i] = w->x_ref[k * VARS_PER_NODE + N_STATES + i];
    }

    /* ── Diagnostics ── */
    {
        double max_dyn_residual = 0.0;
        /* Compute dynamics defect residual (normalized — ref trajectory consistency check) */
        for (k = 0; k < N_INTERVALS; k++) {
            double dt = w->dt_seq[k];
            for (i = 0; i < N_STATES; i++) {
                double xk  = w->X_ref[k * N_STATES + i];
                double xk1 = w->X_ref[(k+1) * N_STATES + i];
                double defect = fabs(xk1 - xk) / (dt + 1e-12);
                if (defect > max_dyn_residual) max_dyn_residual = defect;
            }
        }
        printf("SCP iter %d: ||dx||=%.2e  max|dx/dt|=%.2e", w->iteration, norm_dx, max_dyn_residual);
        printf("\n");
    }

    return (norm_dx < EPS_CONVERGENCE) ? 1 : 0;
}

/* ── Full SCP Solve ──────────────────────────────────────────────────────── */

int {{ problem_name }}_scp_solve({{ problem_name | capitalize }}Workspace *w,
                                  const {{ problem_name | capitalize }}Params *p)
{
    /* Initialize dimensions and SOC cones */
    {{ problem_name }}_init_matrix_dimensions();

    /* Build initial reference */
    {{ problem_name }}_init_reference(w, p, user_x0, user_u0, user_T_total);
    {{ problem_name }}_build_x_ref(w);

    /* Normalize all physical parameters once (used in normalized dynamics) */
    {{ problem_name | capitalize }}ParamsNorm gparams_norm;
    {{ problem_name }}_params_normalize(p, &gparams_norm);

    w->iteration = 0;

    /* SCP main loop */
    for (; w->iteration < MAX_ITER; ) {
        int converged = {{ problem_name }}_scp_iteration(w, &gparams_norm);
        if (converged > 0) {
            printf("SCP converged at iteration %d\n", w->iteration);
            return 0;
        }
        if (converged < 0) return -1;
    }

    printf("SCP did not converge within %d iterations\n", MAX_ITER);
    return -1;
}

/* ── Solution access ─────────────────────────────────────────────────────── */

void {{ problem_name }}_get_final_trajectory(const {{ problem_name | capitalize }}Workspace *w,
                                              double *X_out, double *U_out) {
    memcpy(X_out, w->X_ref, N_STATES * N_NODES * sizeof(double));
    memcpy(U_out, w->U_ref, N_CONTROLS * N_NODES * sizeof(double));
}
