/**
 * {{ problem_name }} — Auto-generated SCP/SOCP Configuration Header
 *
 * Generated by scpgen v{{ version }}
 *
 * Naming convention: all macros are prefixed with {{ guard_name }}_ to avoid
 * symbol conflicts when multiple problems are compiled together.
 */

#ifndef {{ guard_name }}_CONFIG_H
#define {{ guard_name }}_CONFIG_H

/* ── Problem Dimensions ─────────────────────────────────────────────────── */

#define {{ guard_name }}_N_INTERVALS  {{ N_INTERVALS }}   /* Number of discrete intervals */
#define {{ guard_name }}_N_NODES      {{ N_NODES }}       /* Number of nodes (= N_INTERVALS + 1) */
#define {{ guard_name }}_FINAL_NODE   {{ FINAL_NODE }}    /* Index of terminal node */

#define {{ guard_name }}_N_STATES     {{ n_states }}      /* Number of state variables */
#define {{ guard_name }}_N_CONTROLS   {{ n_controls }}    /* Number of control variables */
#define {{ guard_name }}_N_AUX        {{ n_aux }}         /* Number of auxiliary variables */

/* Variables per node (state + control + auxiliary) */
#define {{ guard_name }}_VARS_PER_NODE  {{ vars_per_node }}

/* Total decision variables = N_NODES*VARS_PER_NODE + extra */
#define {{ guard_name }}_NVAR           {{ num_vars }}
#define {{ guard_name }}_NUM_EXTRA_VARS {{ extra_vars_total }}

/* ── Constraint Dimensions ───────────────────────────────────────────────── */

#define {{ guard_name }}_NEQ          {{ num_A_rows }}        /* Equality rows (A matrix) */
#define {{ guard_name }}_NINEQ_LINEAR {{ num_G_linear_rows }} /* Linear inequality rows */
#define {{ guard_name }}_NINEQ_CONE   {{ num_G_cone_rows }}   /* SOC cone rows */
#define {{ guard_name }}_NINEQ        {{ num_G_rows }}        /* Total G rows = linear + cone */
#define {{ guard_name }}_NCONE        {{ num_cones }}         /* Number of SOC cones */

/* ── Row Index Macros (generated from operation block registration) ──────── */

{% for blk in A_blocks %}
#define {{ guard_name }}_ROW_{{ blk.label | upper }}_START  {{ blk.start }}
#define {{ guard_name }}_ROW_{{ blk.label | upper }}_COUNT  {{ blk.end - blk.start }}
{% endfor %}

{% for blk in G_blocks %}
#define {{ guard_name }}_ROW_{{ blk.label | upper }}_START  {{ blk.start }}
#define {{ guard_name }}_ROW_{{ blk.label | upper }}_COUNT  {{ blk.end - blk.start }}
{% endfor %}

/* Convenience: dynamics defect row base for interval k, equation i */
#define {{ guard_name }}_ROW_DYN(k, i)  ({{ guard_name }}_ROW_DYNAMICS_DEFECTS_START + (k) * {{ n_states }} + (i))

/* ── Per-Variable Column Macros (use these instead of hardcoded numbers) ── */

{% for s in states %}
#define {{ guard_name }}_COL_{{ s.name | upper }}(k)  ((k) * {{ guard_name }}_VARS_PER_NODE + {{ loop.index0 }})
{% endfor %}
{% for c in controls %}
#define {{ guard_name }}_COL_{{ c.name | upper }}(k)  ((k) * {{ guard_name }}_VARS_PER_NODE + {{ guard_name }}_N_STATES + {{ loop.index0 }})
{% endfor %}
{% for v in all_variables %}
{% if v.role.value == 'auxiliary' %}
#define {{ guard_name }}_COL_{{ v.name | upper }}(k)  ((k) * {{ guard_name }}_VARS_PER_NODE + {{ guard_name }}_N_STATES + {{ guard_name }}_N_CONTROLS + {{ loop.index0 }})
{% endif %}
{% endfor %}

/* Generic column macros (prefer per-variable macros above) */
#define {{ guard_name }}_COL_STATE(k, s)  ((k) * {{ guard_name }}_VARS_PER_NODE + (s))
#define {{ guard_name }}_COL_CTRL(k, c)   ((k) * {{ guard_name }}_VARS_PER_NODE + {{ guard_name }}_N_STATES + (c))

/* ── CSC Nonzero Counts ─────────────────────────────────────────────────── */

#define NNZ_A           {{ nnz_A }}
#define NNZ_G           {{ nnz_G }}

/* ── SCP Iteration Parameters ────────────────────────────────────────────── */

#define {{ guard_name }}_MAX_ITER        {{ max_iter }}
#define {{ guard_name }}_EPS_CONVERGENCE {{ eps_convergence }}

#endif /* {{ guard_name }}_CONFIG_H */

