/**
 * Compute Jacobians A = ∂f/∂x, B = ∂f/∂u and RHS vector f in PHYSICAL space.
 *
 * @param x    State vector at linearization point (PHYSICAL)
 * @param u    Control vector at linearization point (PHYSICAL)
 * @param t    Time at linearization point (PHYSICAL)
 * @param A    Output: ∂f/∂x  (N_STATES × N_STATES, row-major)
 * @param B    Output: ∂f/∂u  (N_STATES × N_CONTROLS, row-major)
 * @param f    Output: RHS vector f(x,u,t) (PHYSICAL)
 * @param p    Problem parameters
 */
void {{ problem_name }}_compute_dynamics_jacobian_phys(
    const double x[N_STATES], const double u[N_CONTROLS], double t,
    double A[N_STATES * N_STATES],
    double B[N_STATES * N_CONTROLS],
    double f[N_STATES],
    const {{ problem_name | capitalize }}Params *p)
{
{% for ef in external_funcs %}
    double _{{ ef.name }} = {{ ef.name }}(t);  /* cache */
{% endfor %}
    /* ── RHS values ── */
{% for rhs in rhs_expressions %}
    f[{{ loop.index0 }}] = {{ rhs }};
{% endfor %}

    /* ── A matrix: ∂f_i/∂x_j ── */
{% for row in A_jacobian %}
{% set row_idx = loop.index0 %}
{% for entry in row %}
    A[{{ row_idx }} * N_STATES + {{ loop.index0 }}] = {{ entry }};
{% endfor %}
{% endfor %}

    /* ── B matrix: ∂f_i/∂u_j  (B[i*N_CONTROLS + j]) ── */
{% for row in B_jacobian %}
{% set row_idx = loop.index0 %}
{% for entry in row %}
    B[{{ row_idx }} * N_CONTROLS + {{ loop.index0 }}] = {{ entry }};
{% endfor %}
{% endfor %}
}

/* ── Midpoint Jacobian (convenience) ─────────────────────────────────────── */

/**
 * Compute Jacobians at the midpoint between two nodes in PHYSICAL space.
 *
 * x_mid = 0.5 * (x_k + x_{k+1}),  u_mid = 0.5 * (u_k + u_{k+1})
 */
void {{ problem_name }}_compute_midpoint_jacobian_phys(
    const double x_k[N_STATES], const double u_k[N_CONTROLS],
    const double x_k1[N_STATES], const double u_k1[N_CONTROLS],
    double t,
    double A[N_STATES * N_STATES],
    double B[N_STATES * N_CONTROLS],
    double f[N_STATES],
    const {{ problem_name | capitalize }}Params *p)
{
    double x_mid[N_STATES];
    double u_mid[N_CONTROLS];
    int i;

    for (i = 0; i < N_STATES; i++)
        x_mid[i] = 0.5 * (x_k[i] + x_k1[i]);
    for (i = 0; i < N_CONTROLS; i++)
        u_mid[i] = 0.5 * (u_k[i] + u_k1[i]);

    {{ problem_name }}_compute_dynamics_jacobian_phys(x_mid, u_mid, t, A, B, f, p);
}

